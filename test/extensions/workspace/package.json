{
  "name": "workspace-test",
  "displayName": "MoonBit VSCode Workspace Test",
  "publisher": "moonbit",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.86.0"
  },
  "main": "./_build/js/release/build/vscode-workspace-test.js",
  "activationEvents": [
    "onCommand:moonbit.workspace.checkCore",
    "onCommand:moonbit.workspace.checkFileEvents",
    "onCommand:moonbit.workspace.checkProviders",
    "onCommand:moonbit.workspace.checkNotebook",
    "onNotebook:moonbit-workspace-notebook"
  ],
  "contributes": {
    "commands": [
      {
        "command": "moonbit.workspace.checkCore",
        "title": "MoonBit Workspace Check Core"
      },
      {
        "command": "moonbit.workspace.checkFileEvents",
        "title": "MoonBit Workspace Check File Events"
      },
      {
        "command": "moonbit.workspace.checkProviders",
        "title": "MoonBit Workspace Check Providers"
      },
      {
        "command": "moonbit.workspace.checkNotebook",
        "title": "MoonBit Workspace Check Notebook"
      }
    ],
    "configuration": {
      "title": "MoonBit Workspace Test",
      "properties": {
        "moonbit.workspace.value": {
          "type": "string",
          "default": "default",
          "description": "Workspace setting used by workspace binding tests.",
          "scope": "resource"
        }
      }
    },
    "notebooks": [
      {
        "type": "moonbit-workspace-notebook",
        "displayName": "MoonBit Workspace Notebook",
        "selector": [
          {
            "filenamePattern": "*.moonbitworkspace"
          }
        ]
      }
    ]
  },
  "scripts": {
    "clean:fixture": "node -e \"const fs=require('fs');const path=require('path');const dir=path.join(process.cwd(),'fixture');if(fs.existsSync(dir)){for(const name of fs.readdirSync(dir)){if(name!=='.gitkeep'){fs.rmSync(path.join(dir,name),{recursive:true,force:true});}}}\"",
    "build:moonbit": "moon build --target js",
    "build:ui-test": "tsc -p ./ui-test",
    "ui-test": "npm run clean:fixture && npm run build:moonbit && npm run build:ui-test && extest setup-and-run './out/ui-test/*.test.js' --code_version max --code_settings settings.json --extensions_dir .test-extensions --mocha_config ui-test/.mocharc.js --open_resource ./fixture"
  },
  "repository": {
    "type": "git",
    "url": "https://www.github.com/bzy-debug/vscode.mbt"
  },
  "devDependencies": {
    "@types/chai": "^4.3.16",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.2.0",
    "chai": "^6.2.2",
    "mocha": "^11.7.5",
    "typescript": "^5.9.3",
    "vscode-extension-tester": "^8.21.0"
  }
}
