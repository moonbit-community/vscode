{
  "name": "window-test",
  "displayName": "MoonBit VSCode Window Test",
  "publisher": "moonbit",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.86.0"
  },
  "main": "./_build/js/release/build/vscode-window-test.js",
  "activationEvents": [
    "onCommand:moonbit.window.checkCore",
    "onCommand:moonbit.window.checkQuickInput",
    "onCommand:moonbit.window.checkTerminal",
    "onCommand:moonbit.window.checkProviders",
    "onNotebook:moonbit-window-notebook",
    "onCustomEditor:moonbit.window.customEditor"
  ],
  "contributes": {
    "commands": [
      {
        "command": "moonbit.window.checkCore",
        "title": "MoonBit Window Check Core"
      },
      {
        "command": "moonbit.window.checkQuickInput",
        "title": "MoonBit Window Check Quick Input"
      },
      {
        "command": "moonbit.window.checkTerminal",
        "title": "MoonBit Window Check Terminal"
      },
      {
        "command": "moonbit.window.checkProviders",
        "title": "MoonBit Window Check Providers"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "moonbit.window.treeView",
          "name": "MoonBit Window Tree"
        },
        {
          "id": "moonbit.window.webviewView",
          "type": "webview",
          "name": "MoonBit Window Webview"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "moonbit.window.customEditor",
        "displayName": "MoonBit Window Custom Editor",
        "selector": [
          {
            "filenamePattern": "*.moonbitwindow"
          }
        ],
        "priority": "default"
      }
    ],
    "notebooks": [
      {
        "type": "moonbit-window-notebook",
        "displayName": "MoonBit Window Notebook",
        "selector": [
          {
            "filenamePattern": "*.moonbitwindow-nb"
          }
        ]
      }
    ],
    "terminal": {
      "profiles": [
        {
          "id": "moonbit.window.terminalProfile",
          "title": "MoonBit Window Terminal Profile"
        }
      ]
    }
  },
  "scripts": {
    "clean:fixture": "node -e \"const fs=require('fs');const path=require('path');const dir=path.join(process.cwd(),'fixture');if(fs.existsSync(dir)){for(const name of fs.readdirSync(dir)){if(name!=='.gitkeep'){fs.rmSync(path.join(dir,name),{recursive:true,force:true});}}}\"",
    "build:moonbit": "moon build --target js",
    "build:ui-test": "tsc -p ./ui-test",
    "ui-test": "npm run clean:fixture && npm run build:moonbit && npm run build:ui-test && extest setup-and-run './out/ui-test/*.test.js' --code_version max --code_settings settings.json --extensions_dir .test-extensions --mocha_config ui-test/.mocharc.js --open_resource ./fixture"
  },
  "repository": {
    "type": "git",
    "url": "https://www.github.com/bzy-debug/vscode.mbt"
  },
  "devDependencies": {
    "@types/chai": "^4.3.16",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.2.0",
    "chai": "^6.2.2",
    "mocha": "^11.7.5",
    "typescript": "^5.9.3",
    "vscode-extension-tester": "^8.21.0"
  }
}
