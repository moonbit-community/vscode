{
  "name": "vscode-mbt-smoke-extension",
  "displayName": "VS Code MoonBit Binding Smoke Tests",
  "description": "Small extension used by integration tests for the MoonBit VS Code API bindings.",
  "version": "0.0.1",
  "publisher": "vscode-mbt-tests",
  "private": true,
  "engines": {
    "vscode": "^1.100.0"
  },
  "activationEvents": [
    "onCommand:vscode-mbt-tests.echo",
    "onCommand:vscode-mbt-tests.hasCommand",
    "onCommand:vscode-mbt-tests.statusBar",
    "onCommand:vscode-mbt-tests.workspaceEdit",
    "onCommand:vscode-mbt-tests.event",
    "onCommand:vscode-mbt-tests.treeView",
    "onCommand:vscode-mbt-tests.uiTreeView",
    "onCommand:vscode-mbt-tests.webviewView",
    "onCommand:vscode-mbt-tests.uiWebviewView",
    "onCommand:vscode-mbt-tests.fileDecoration",
    "onCommand:vscode-mbt-tests.uiFileDecoration",
    "onCommand:vscode-mbt-tests.inlineCompletion",
    "onCommand:vscode-mbt-tests.documentPaste",
    "onCommand:vscode-mbt-tests.documentDrop",
    "onCommand:vscode-mbt-tests.uiDocumentDrop",
    "onCommand:vscode-mbt-tests.commentingRange",
    "onCommand:vscode-mbt-tests.quickDiff",
    "onCommand:vscode-mbt-tests.terminalLink",
    "onCommand:vscode-mbt-tests.uiTerminalLink",
    "onCommand:vscode-mbt-tests.terminalProfile",
    "onCommand:vscode-mbt-tests.uiTerminalProfile",
    "onTerminalProfile:vscode-mbt-smoke-terminal-profile",
    "onCommand:vscode-mbt-tests.contentProviderUri",
    "onCommand:vscode-mbt-tests.fileSystemProviderUri",
    "onCommand:vscode-mbt-tests.fileSystemReadDirectory",
    "onLanguage:vscode-mbt-smoke-language",
    "onLanguage:vscode-mbt-smoke-document-formatting",
    "onLanguage:vscode-mbt-smoke-range-formatting",
    "onLanguage:vscode-mbt-smoke-on-type-formatting",
    "onLanguage:vscode-mbt-smoke-semantic-tokens",
    "onLanguage:vscode-mbt-smoke-range-semantic-tokens"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "authentication": [
      {
        "id": "vscode-mbt-smoke-auth",
        "label": "MoonBit Smoke Auth"
      }
    ],
    "taskDefinitions": [
      {
        "type": "vscode-mbt-smoke-task",
        "required": [
          "script"
        ],
        "properties": {
          "script": {
            "type": "string"
          },
          "fromMoonBit": {
            "type": "boolean"
          }
        }
      }
    ],
    "terminal": {
      "profiles": [
        {
          "id": "vscode-mbt-smoke-terminal-profile",
          "title": "MoonBit Smoke Profile",
          "icon": "terminal",
          "titleTemplate": "${sequence}"
        }
      ]
    },
    "languages": [
      {
        "id": "vscode-mbt-smoke-language"
      },
      {
        "id": "vscode-mbt-smoke-document-formatting"
      },
      {
        "id": "vscode-mbt-smoke-range-formatting"
      },
      {
        "id": "vscode-mbt-smoke-on-type-formatting"
      },
      {
        "id": "vscode-mbt-smoke-semantic-tokens"
      },
      {
        "id": "vscode-mbt-smoke-range-semantic-tokens"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "vscode-mbt-smoke-tree",
          "name": "MoonBit Smoke Tree"
        },
        {
          "id": "vscode-mbt-smoke-webview",
          "name": "MoonBit Smoke Webview",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "vscode-mbt-tests.echo",
        "title": "MoonBit Smoke: Echo"
      },
      {
        "command": "vscode-mbt-tests.hasCommand",
        "title": "MoonBit Smoke: Has Command"
      },
      {
        "command": "vscode-mbt-tests.statusBar",
        "title": "MoonBit Smoke: Status Bar"
      },
      {
        "command": "vscode-mbt-tests.workspaceEdit",
        "title": "MoonBit Smoke: Workspace Edit"
      },
      {
        "command": "vscode-mbt-tests.event",
        "title": "MoonBit Smoke: Event"
      },
      {
        "command": "vscode-mbt-tests.treeView",
        "title": "MoonBit Smoke: Tree View"
      },
      {
        "command": "vscode-mbt-tests.uiTreeView",
        "title": "MoonBit Smoke: Tree View Visual"
      },
      {
        "command": "vscode-mbt-tests.webviewView",
        "title": "MoonBit Smoke: Webview View"
      },
      {
        "command": "vscode-mbt-tests.uiWebviewView",
        "title": "MoonBit Smoke: Webview View Visual"
      },
      {
        "command": "vscode-mbt-tests.fileDecoration",
        "title": "MoonBit Smoke: File Decoration"
      },
      {
        "command": "vscode-mbt-tests.uiFileDecoration",
        "title": "MoonBit Smoke: File Decoration Visual"
      },
      {
        "command": "vscode-mbt-tests.inlineCompletion",
        "title": "MoonBit Smoke: Inline Completion"
      },
      {
        "command": "vscode-mbt-tests.documentPaste",
        "title": "MoonBit Smoke: Document Paste"
      },
      {
        "command": "vscode-mbt-tests.documentDrop",
        "title": "MoonBit Smoke: Document Drop"
      },
      {
        "command": "vscode-mbt-tests.uiDocumentDrop",
        "title": "MoonBit Smoke: Document Drop Visual"
      },
      {
        "command": "vscode-mbt-tests.commentingRange",
        "title": "MoonBit Smoke: Commenting Range"
      },
      {
        "command": "vscode-mbt-tests.quickDiff",
        "title": "MoonBit Smoke: Quick Diff"
      },
      {
        "command": "vscode-mbt-tests.terminalLink",
        "title": "MoonBit Smoke: Terminal Link"
      },
      {
        "command": "vscode-mbt-tests.uiTerminalLink",
        "title": "MoonBit Smoke: Terminal Link Visual"
      },
      {
        "command": "vscode-mbt-tests.terminalProfile",
        "title": "MoonBit Smoke: Terminal Profile"
      },
      {
        "command": "vscode-mbt-tests.uiTerminalProfile",
        "title": "MoonBit Smoke: Terminal Profile Visual"
      },
      {
        "command": "vscode-mbt-tests.contentProviderUri",
        "title": "MoonBit Smoke: Content Provider URI"
      },
      {
        "command": "vscode-mbt-tests.fileSystemProviderUri",
        "title": "MoonBit Smoke: File System Provider URI"
      },
      {
        "command": "vscode-mbt-tests.fileSystemReadDirectory",
        "title": "MoonBit Smoke: File System Read Directory"
      }
    ]
  },
  "scripts": {
    "build:moonbit": "moon build --target js --release && node copy-build.js",
    "check:moonbit": "moon check --target js"
  }
}
