{
  "name": "commands-test",
  "displayName": "MoonBit VSCode Commands Test",
  "publisher": "moonbit",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.86.0"
  },
  "main": "./_build/js/release/build/vscode-commands-test.js",
  "activationEvents": [
    "onCommand:moonbit.commands.showStatus",
    "onCommand:moonbit.commands.openEditor",
    "onCommand:moonbit.commands.runNestedOpenEditor",
    "onCommand:moonbit.commands.showCommandCount",
    "onCommand:moonbit.commands.ensureCommand",
    "onCommand:moonbit.commands.insertText",
    "onCommand:moonbit.commands.insertTextAsync"
  ],
  "contributes": {
    "commands": [
      {
        "command": "moonbit.commands.showStatus",
        "title": "MoonBit Commands Show Status"
      },
      {
        "command": "moonbit.commands.openEditor",
        "title": "MoonBit Commands Open Editor"
      },
      {
        "command": "moonbit.commands.runNestedOpenEditor",
        "title": "MoonBit Commands Run Nested Open Editor"
      },
      {
        "command": "moonbit.commands.showCommandCount",
        "title": "MoonBit Commands Show Command Count"
      },
      {
        "command": "moonbit.commands.ensureCommand",
        "title": "MoonBit Commands Ensure Command"
      },
      {
        "command": "moonbit.commands.insertText",
        "title": "MoonBit Commands Insert Text"
      },
      {
        "command": "moonbit.commands.insertTextAsync",
        "title": "MoonBit Commands Insert Text Async"
      }
    ]
  },
  "scripts": {
    "build:moonbit": "moon build --target js",
    "build:ui-test": "tsc -p ./ui-test",
    "ui-test": "npm run build:moonbit && npm run build:ui-test && extest setup-and-run './out/ui-test/*.test.js' --code_version max --code_settings settings.json --extensions_dir .test-extensions --mocha_config ui-test/.mocharc.js"
  },
  "repository": {
    "type": "git",
    "url": "https://www.github.com/bzy-debug/vscode.mbt"
  },
  "devDependencies": {
    "@types/chai": "^4.3.16",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.2.0",
    "chai": "^6.2.2",
    "mocha": "^11.7.5",
    "typescript": "^5.9.3",
    "vscode-extension-tester": "^8.21.0"
  }
}
