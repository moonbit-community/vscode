{
  "name": "decorator-sample",
  "description": "Sample for the decorator API",
  "version": "0.0.1",
  "publisher": "vscode-samples",
  "license": "MIT",
  "engines": {
    "vscode": "^1.100.0"
  },
  "repository": {
    "url": "https://github.com/Microsoft/vscode-extension-samples"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./_build/js/release/build/vscode-sample-decorator-sample.js",
  "contributes": {
    "colors": [
      {
        "id": "myextension.largeNumberBackground",
        "description": "Background decoration color for large numbers",
        "defaults": {
          "dark": "#FF000055",
          "light": "#FF000055",
          "highContrast": "#FF000055"
        }
      }
    ]
  },
  "scripts": {
    "build:moonbit": "moon build --target js --release"
  }
}
