{
  "name": "lsp-embedded-language-service-sample",
  "description": "A language server example using language services to support embedded languages",
  "author": "Microsoft Corporation",
  "license": "MIT",
  "version": "1.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Microsoft/vscode-extension-samples"
  },
  "publisher": "vscode-samples",
  "categories": [],
  "keywords": [],
  "engines": {
    "vscode": "^1.100.0"
  },
  "activationEvents": [
    "onLanguage:html1"
  ],
  "main": "./_build/js/release/build/vscode-sample-lsp-embedded-request-forwarding.js",
  "contributes": {
    "languages": [
      {
        "id": "html1",
        "extensions": [
          ".html1"
        ]
      }
    ],
    "grammars": [
      {
        "language": "html1",
        "scopeName": "text.html1.basic",
        "path": "./syntaxes/html1.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "build:moonbit": "moon build --target js --release"
  }
}
