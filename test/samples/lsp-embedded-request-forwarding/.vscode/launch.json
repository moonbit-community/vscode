{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}"
      ],
      "preLaunchTask": "moon: build (js release)",
      "outFiles": [
        "${workspaceFolder}/_build/js/release/**/*.js"
      ]
    }
  ]
}
