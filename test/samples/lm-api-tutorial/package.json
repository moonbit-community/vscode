{
  "name": "code-tutor",
  "displayName": "Code Tutor",
  "description": "Your personal AI code tutor",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./_build/js/release/build/vscode-sample-lm-api-tutorial.js",
  "contributes": {
    "commands": [
      {
        "command": "code-tutor.annotate",
        "title": "Toggle Tutor Annotations",
        "icon": "$(comment)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "code-tutor.annotate",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "build:moonbit": "moon build --target js --release"
  }
}
