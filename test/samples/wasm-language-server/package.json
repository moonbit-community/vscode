{
  "name": "wasm-language-server",
  "description": "An example demonstrating how to implement a language server as a WebAssembly module.",
  "author": "Microsoft Corporation",
  "license": "MIT",
  "version": "1.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Microsoft/vscode-extension-samples"
  },
  "publisher": "vscode-samples",
  "categories": [],
  "keywords": [
    "WASM",
    "Component Model",
    "LSP",
    "Language Server"
  ],
  "engines": {
    "vscode": "^1.100.0"
  },
  "main": "./_build/js/release/build/vscode-sample-wasm-language-server.js",
  "browser": "./client/dist/web/extension",
  "activationEvents": [
    "onLanguage:plaintext"
  ],
  "extensionDependencies": [
    "ms-vscode.wasm-wasi-core"
  ],
  "contributes": {
    "commands": [
      {
        "command": "vscode-samples.wasm-language-server.countFiles",
        "category": "Samples",
        "title": "Count Files"
      }
    ]
  },
  "scripts": {
    "build:moonbit": "moon build --target js --release"
  }
}
