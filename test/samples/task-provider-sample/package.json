{
  "name": "task-provider-samples",
  "displayName": "Task Provider Samples",
  "description": "Samples for VSCode's view API",
  "version": "0.0.1",
  "publisher": "vscode-samples",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Microsoft/vscode-extension-samples"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:workbench.action.tasks.runTask"
  ],
  "main": "./_build/js/release/build/vscode-sample-task-provider-sample.js",
  "contributes": {
    "taskDefinitions": [
      {
        "type": "rake",
        "required": [
          "task"
        ],
        "properties": {
          "task": {
            "type": "string",
            "description": "The Rake task to customize"
          },
          "file": {
            "type": "string",
            "description": "The Rake file that provides the task. Can be omitted."
          }
        }
      },
      {
        "type": "custombuildscript",
        "required": [
          "flavor"
        ],
        "properties": {
          "flavor": {
            "type": "string",
            "description": "The build flavor. Should be either '32' or '64'."
          },
          "flags": {
            "type": "array",
            "description": "Additional build flags."
          }
        }
      }
    ]
  },
  "scripts": {
    "build:moonbit": "moon build --target js --release"
  }
}
