{
  "name": "chat-context-sample",
  "displayName": "chat-context-sample",
  "description": "Sample extension demonstrating the Chat Context Provider API",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.109.0"
  },
  "categories": [
    "Other"
  ],
  "enabledApiProposals": [
    "chatContextProvider"
  ],
  "activationEvents": [
    "onChatContextProvider:chat-context-sample.jsonLineCount",
    "onLanguage:json",
    "onLanguage:jsonc"
  ],
  "main": "./_build/js/release/build/vscode-sample-chat-context-sample.js",
  "contributes": {
    "chatContext": [
      {
        "id": "chat-context-sample.jsonLineCount",
        "icon": "$(json)",
        "displayName": "JSON Line Count"
      }
    ]
  },
  "scripts": {
    "build:moonbit": "moon build --target js --release"
  }
}
