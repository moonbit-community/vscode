{
  "name": "virtual-document-sample-moonbit-port",
  "displayName": "MoonBit Port: Cowsay in virtual documents",
  "publisher": "moonbit",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.100.0"
  },
  "main": "./_build/js/release/build/vscode-sample-virtual-document-sample.js",
  "activationEvents": [
    "onCommand:cowsay.say",
    "onCommand:cowsay.backwards"
  ],
  "contributes": {
    "commands": [
      {
        "command": "cowsay.say",
        "title": "cowsay"
      },
      {
        "command": "cowsay.backwards",
        "title": "cowsay (↹)"
      }
    ]
  },
  "scripts": {
    "build:moonbit": "moon build --target js"
  },
  "repository": {
    "type": "git",
    "url": "https://www.github.com/bzy-debug/vscode.mbt"
  }
}
