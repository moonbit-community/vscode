{
  "name": "l10n-sample-moonbit-port",
  "displayName": "MoonBit Port: l10n-sample",
  "publisher": "moonbit",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.100.0"
  },
  "main": "./_build/js/release/build/vscode-sample-l10n-sample.js",
  "activationEvents": [
    "onCommand:extension.sayHello",
    "onCommand:extension.sayBye"
  ],
  "contributes": {
    "commands": [
      {
        "command": "extension.sayHello",
        "title": "%extension.sayHello.title%"
      },
      {
        "command": "extension.sayBye",
        "title": "%extension.sayBye.title%"
      }
    ]
  },
  "scripts": {
    "build:moonbit": "moon build --target js"
  },
  "repository": {
    "type": "git",
    "url": "https://www.github.com/bzy-debug/vscode.mbt"
  }
}
