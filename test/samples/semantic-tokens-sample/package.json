{
  "name": "semantic-tokens-sample",
  "displayName": "semantic-tokens-sample",
  "description": "Sample showing the Semantic Tokens Provider API",
  "version": "0.0.1",
  "publisher": "vscode-samples",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Microsoft/vscode-extension-samples"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:semanticLanguage"
  ],
  "main": "./_build/js/release/build/vscode-sample-semantic-tokens-sample.js",
  "contributes": {
    "languages": [
      {
        "id": "semanticLanguage",
        "extensions": [
          ".semanticLanguage"
        ]
      }
    ]
  },
  "scripts": {
    "build:moonbit": "moon build --target js --release"
  }
}
