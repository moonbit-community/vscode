{
  "name": "tree-view-sample-moonbit-port",
  "displayName": "MoonBit Port: Custom view Samples",
  "publisher": "moonbit",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.100.0"
  },
  "main": "./_build/js/release/build/vscode-sample-tree-view-sample.js",
  "activationEvents": [
    "onLanguage:json",
    "onLanguage:jsonc",
    "onCommand:nodeDependencies.refreshEntry",
    "onCommand:nodeDependencies.addEntry",
    "onCommand:nodeDependencies.editEntry",
    "onCommand:nodeDependencies.deleteEntry",
    "onCommand:ftpExplorer.refresh",
    "onCommand:ftpExplorer.openFtpResource",
    "onCommand:ftpExplorer.revealResource",
    "onCommand:jsonOutline.refresh",
    "onCommand:jsonOutline.refreshNode",
    "onCommand:jsonOutline.renameNode",
    "onCommand:fileExplorer.refreshFile",
    "onCommand:fileExplorer.openFile",
    "onCommand:testView.reveal",
    "onCommand:testView.changeTitle"
  ],
  "contributes": {
    "commands": [
      {
        "command": "nodeDependencies.refreshEntry",
        "title": "Refresh"
      },
      {
        "command": "nodeDependencies.addEntry",
        "title": "Add"
      },
      {
        "command": "nodeDependencies.editEntry",
        "title": "Edit"
      },
      {
        "command": "nodeDependencies.deleteEntry",
        "title": "Delete"
      },
      {
        "command": "ftpExplorer.refresh",
        "title": "Refresh"
      },
      {
        "command": "ftpExplorer.openFtpResource",
        "title": "Open FTP Resource"
      },
      {
        "command": "ftpExplorer.revealResource",
        "title": "Reveal in FTP View"
      },
      {
        "command": "jsonOutline.refresh",
        "title": "Refresh"
      },
      {
        "command": "jsonOutline.refreshNode",
        "title": "Refresh"
      },
      {
        "command": "jsonOutline.renameNode",
        "title": "Rename"
      },
      {
        "command": "fileExplorer.refreshFile",
        "title": "Refresh"
      },
      {
        "command": "fileExplorer.openFile",
        "title": "Open File"
      },
      {
        "command": "testView.reveal",
        "title": "Test View: Reveal"
      },
      {
        "command": "testView.changeTitle",
        "title": "Test View: Change Title"
      }
    ]
  },
  "scripts": {
    "build:moonbit": "moon build --target js"
  },
  "repository": {
    "type": "git",
    "url": "https://www.github.com/bzy-debug/vscode.mbt"
  }
}
