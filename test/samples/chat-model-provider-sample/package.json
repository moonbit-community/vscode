{
  "name": "chat-model-provider-sample",
  "publisher": "vscode-samples",
  "displayName": "Copilot Model Provider Sample",
  "description": "Sample extension which provides chat models via the LM API.",
  "repository": {
    "type": "git",
    "url": "https://github.com/Microsoft/vscode-extension-samples"
  },
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.104"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "contributes": {
    "languageModelChatProviders": [
      {
        "vendor": "sample",
        "displayName": "Sample Model Vendor"
      }
    ]
  },
  "main": "./_build/js/release/build/vscode-sample-chat-model-provider-sample.js",
  "scripts": {
    "build:moonbit": "moon build --target js --release"
  }
}
