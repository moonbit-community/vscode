  async fn provide_file_decoration(Self, Uri, CancellationToken) -> FileDecoration?
}

pub(open) trait FileSystemProvider {
  fn on_did_change_file(Self) -> Event[Array[FileChangeEvent]]
  fn watch(Self, Uri, Bool, Array[String]) -> Disposable
  async fn stat(Self, Uri) -> FileStat
  async fn read_directory(Self, Uri) -> Array[DirectoryEntry]
  async fn create_directory(Self, Uri) -> Unit
  async fn read_file(Self, Uri) -> Bytes
  async fn write_file(Self, Uri, Bytes, Bool, Bool) -> Unit
  async fn delete(Self, Uri, Bool) -> Unit
  async fn rename(Self, Uri, Uri, Bool) -> Unit
  async fn copy(Self, Uri, Uri, Bool) -> Unit
}

pub(open) trait FoldingRangeProvider {
  async fn provide_folding_ranges(Self, TextDocument, FoldingContext, CancellationToken) -> Array[FoldingRange]?
}

pub(open) trait HoverProvider {
  async fn provide_hover(Self, TextDocument, Position, CancellationToken) -> Hover?
}

pub(open) trait ImplementationProvider {
  async fn provide_implementation(Self, TextDocument, Position, CancellationToken) -> Array[Location]?
}

pub(open) trait InlayHintsProvider {
  async fn provide_inlay_hints(Self, TextDocument, Range, CancellationToken) -> Array[InlayHint]?
  async fn resolve_inlay_hint(Self, InlayHint, CancellationToken) -> InlayHint?
}

pub(open) trait InlineCompletionItemProvider {
  async fn provide_inline_completion_items(Self, TextDocument, Position, InlineCompletionContext, CancellationToken) -> Array[InlineCompletionItem]?
}

pub(open) trait InlineValuesProvider {
  async fn provide_inline_values(Self, TextDocument, Range, InlineValueContext, CancellationToken) -> Array[InlineValue]?
}

pub(open) trait LinkedEditingRangeProvider {
  async fn provide_linked_editing_ranges(Self, TextDocument, Position, CancellationToken) -> LinkedEditingRanges?
}

pub(open) trait OnTypeFormattingEditProvider {
  async fn provide_on_type_formatting_edits(Self, TextDocument, Position, String, FormattingOptions, CancellationToken) -> Array[TextEdit]?
}

pub(open) trait QuickDiffProvider {
  async fn provide_original_resource(Self, Uri, CancellationToken) -> Uri?
}

pub(open) trait ReferenceProvider {
  async fn provide_references(Self, TextDocument, Position, ReferenceContext, CancellationToken) -> Array[Location]?
}

pub(open) trait RenameProvider {
  async fn provide_rename_edits(Self, TextDocument, Position, String, CancellationToken) -> WorkspaceEdit?
  async fn prepare_rename(Self, TextDocument, Position, CancellationToken) -> Range?
}

pub(open) trait SelectionRangeProvider {
  async fn provide_selection_ranges(Self, TextDocument, Array[Position], CancellationToken) -> Array[SelectionRange]?
}

pub(open) trait SignatureHelpProvider {
  async fn provide_signature_help(Self, TextDocument, Position, CancellationToken, SignatureHelpContext) -> SignatureHelp?
}

pub(open) trait TaskProvider {
  async fn provide_tasks(Self, CancellationToken) -> Array[Task]?
  async fn resolve_task(Self, Task, CancellationToken) -> Task?
}

pub(open) trait TerminalLinkProvider {
  async fn provide_terminal_links(Self, TerminalLinkContext, CancellationToken) -> Array[TerminalLink]?
  async fn handle_terminal_link(Self, TerminalLink) -> Unit
}

pub(open) trait TerminalProfileProvider {
  async fn provide_terminal_profile(Self, CancellationToken) -> TerminalProfile?
}

pub(open) trait TextDocumentContentProvider {
  fn on_did_change(Self) -> Event[Uri]?
  async fn provide_text_document_content(Self, Uri, CancellationToken) -> String
}

pub(open) trait TypeDefinitionProvider {
  async fn provide_type_definition(Self, TextDocument, Position, CancellationToken) -> Array[Location]?
}

pub(open) trait TypeHierarchyProvider {
  async fn prepare_type_hierarchy(Self, TextDocument, Position, CancellationToken) -> Array[TypeHierarchyItem]?
  async fn provide_type_hierarchy_supertypes(Self, TypeHierarchyItem, CancellationToken) -> Array[TypeHierarchyItem]?
  async fn provide_type_hierarchy_subtypes(Self, TypeHierarchyItem, CancellationToken) -> Array[TypeHierarchyItem]?
}

pub(open) trait WebviewViewProvider {
  async fn resolve_webview_view(Self, WebviewView, WebviewViewResolveContext, CancellationToken) -> Unit
}

pub(open) trait WorkspaceSymbolProvider {
  async fn provide_workspace_symbols(Self, String, CancellationToken) -> Array[SymbolInformation]?
  async fn resolve_workspace_symbol(Self, SymbolInformation, CancellationToken) -> SymbolInformation?
}
